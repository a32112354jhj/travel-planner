# -------------------------------------------------------
# 環境變數設定
#
# 此檔案的變數不會被 Prisma 自動載入，
# 而是透過 prisma.config.ts 中的 import "dotenv/config" 來讀取。
# Next.js 也會自動載入 .env 中的變數。
# -------------------------------------------------------

# 資料庫連線字串
# 會被 prisma.config.ts 和 lib/prisma.ts 讀取
#
# SQLite（目前使用）：
DATABASE_URL="file:./dev.db"
#
# 如果之後要換成 PostgreSQL，改成：
# DATABASE_URL="postgresql://使用者:密碼@主機:5432/資料庫名稱"